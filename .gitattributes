.gitleaks/* text eol=lf

# Generated from the API and codebase inventories: keep this side on merge,
# then the post-merge hook regenerates it from the merged code
# (scripts/lib/merge-regenerate.mjs). The driver is installed in git config by
# the pre-commit hook and postinstall; without it, git merges as text.
artifacts/benchmarks/baseline.json merge=ifc-regenerated
# The split plan files are generated from Sprint_plan.csv (which merges as text):
# same driver, regenerated by split-sprint-plan.ts after the merge.
apps/project-tracker/docs/metrics/_global/Sprint_plan_*.csv merge=ifc-regenerated
