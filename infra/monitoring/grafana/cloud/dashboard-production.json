{
  "_comment": "ENV-008-AI production service dashboard (ADR-087). Applied by .github/workflows/grafana-dashboard.yml with tools/scripts/observability/apply-grafana-dashboard.mjs. Only api and ai-worker emit telemetry today; queries use the span-metric series production has (traces_spanmetrics_calls_total and the native histogram traces_spanmetrics_latency).",
  "folderUid": "intelliflow-prod",
  "dashboard": {
    "uid": "env008-production",
    "title": "IntelliFlow production services",
    "tags": ["env-008-ai", "production"],
    "timezone": "utc",
    "schemaVersion": 39,
    "refresh": "1m",
    "time": { "from": "now-24h", "to": "now" },
    "panels": [
      {
        "type": "timeseries",
        "title": "Request rate by service",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"api|ai-worker\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
            "legendFormat": "{{service}}"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Error ratio by service",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "min": 0 },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"api|ai-worker\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"api|ai-worker\"}[$__rate_interval]))",
            "legendFormat": "{{service}}"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "api p95 latency (server, health probes excluded)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0.2 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency{service=\"api\", span_kind=\"SPAN_KIND_SERVER\", span_name!~\"(GET|HEAD) (/api)?/health(/.*)?\"}[$__rate_interval])))",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "ai-worker llm.invoke calls by status",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "sum by (status_code) (rate(traces_spanmetrics_calls_total{service=\"ai-worker\", span_name=\"llm.invoke\"}[$__rate_interval]))",
            "legendFormat": "{{status_code}}"
          }
        ]
      },
      {
        "type": "stat",
        "title": "api availability over the range (objective 99.9%)",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 0.999 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "sum(increase(traces_spanmetrics_calls_total{service=\"api\", span_kind=\"SPAN_KIND_SERVER\", span_name!~\"(GET|HEAD) (/api)?/health(/.*)?\", status_code!=\"STATUS_CODE_ERROR\"}[$__range])) / sum(increase(traces_spanmetrics_calls_total{service=\"api\", span_kind=\"SPAN_KIND_SERVER\", span_name!~\"(GET|HEAD) (/api)?/health(/.*)?\"}[$__range]))",
            "instant": true
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "MTTD per error episode (live proxy)",
        "description": "Live proxy, not the KPI (IFC-074). Per minute: error spans (A), error-level ai-worker log lines (B, the lines ifc074-error-logs-direct alerts on) and first Alerting transitions by rule from the alert state history (C). The gap between an error burst and the first alert bar is the detection delay. The official MTTD (first alert per error episode, mean < 120 s over >= 10 real episodes) is the collector result in artifacts/reports/mttr-baseline.json and the IFC-074 task KPI in the tracker.",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
        "fieldConfig": {
          "defaults": { "unit": "short", "min": 0 },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "sum by (service) (increase(traces_spanmetrics_calls_total{service=~\"api|ai-worker\", status_code=\"STATUS_CODE_ERROR\"}[1m]))",
            "legendFormat": "error spans {{service}}"
          },
          {
            "refId": "B",
            "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
            "queryType": "range",
            "expr": "sum by (service_name) (count_over_time({service_name=\"ai-worker\"} != \"Latency alert generated\" | detected_level=~\"(?i)error|fatal|critical\" or severity_text=~\"(?i)error|fatal|critical\" [1m]))",
            "legendFormat": "error logs {{service_name}}"
          },
          {
            "refId": "C",
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-alert-state-history"
            },
            "queryType": "range",
            "expr": "sum by (ruleUID) (count_over_time({from=\"state-history\"} | json | current=~\"Alerting.*\" and previous!~\"Alerting.*\" [1m]))",
            "legendFormat": "alert fired {{ruleUID}}"
          }
        ]
      }
    ]
  }
}
