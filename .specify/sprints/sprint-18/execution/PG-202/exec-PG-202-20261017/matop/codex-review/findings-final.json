  "findings": [
    {
      "severity": "high",
      "file": "apps/api/src/modules/calendar/availability-enforcement.ts",
      "line": "186-194",
      "rule": "non-atomic-daily-cap",
      "issue": "Concurrent bookings can exceed the firm's daily booking limit because counting and saving are separate operations.",
      "evidence": "`await prisma.appointment.count(...)` followed by `evaluateAvailability(... sameDayCount)` only checks the current count; appointments.create and appointments.reschedule subsequently persist through separate use-case calls without a shared transaction or lock. With maxDailyBookings=1 and an empty day, two concurrent requests for different times both read zero, pass validation, and save, leaving two counted bookings. The tests stub a fixed count and never exercise concurrent persistence.",
      "fix": "Perform the cap check and appointment persistence in one transaction that serializes bookings for the tenant and local date, using a shared lock or serializable isolation with retries across both create and reschedule.",
      "fingerprint": "25c5826ce3b9259f52ce545671308c7f3a26a92adab5c21a2fe8bee058178a6b"
    }
