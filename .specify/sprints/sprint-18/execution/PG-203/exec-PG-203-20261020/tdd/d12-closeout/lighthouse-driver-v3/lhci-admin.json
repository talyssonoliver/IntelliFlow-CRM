{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3400/settings/privacy-requests",
        "http://localhost:3400/calendar/event-types"
      ],
      "numberOfRuns": 3,
      "puppeteerScript": "./tools/lighthouse/lhci-auth.js",
      "settings": {
        "preset": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility"
        ],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage"
      }
    }
  }
}