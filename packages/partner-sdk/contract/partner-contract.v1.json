  "assertion": {
    "alg": "EdDSA",
    "audience": "intelliflow-crm",
    "maxTtlSeconds": 60,
    "claims": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "aud": {
          "type": "string",
          "const": "intelliflow-crm"
        },
        "sub": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
