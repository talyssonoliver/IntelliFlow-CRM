            "minLength": 1,
            "maxLength": 300
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "source": {
            "type": "string",
            "maxLength": 50
          },
          "extraTags": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 50
            }
          }
        },
        "required": ["requestId", "email", "category", "subject", "message"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        },
        "required": ["ticketId", "tenantId", "requestId", "created"],
        "additionalProperties": false
      }
    }
  }
}
