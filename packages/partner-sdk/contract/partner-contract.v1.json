        "additionalProperties": false
      }
    },
    "partner.listMembers": {
      "kind": "query",
      "scope": "tenants:read",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["tenantId"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": ["ADMIN", "MEMBER"]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "HOME",
                    "PORTAL_MEMBER",
                    "PORTAL_STAFF",
                    "OWNER_INVITE",
                    "PARTNER_CREATED"
                  ]
                },
                "pinned": {
                  "type": "boolean"
                },
                "expiresAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "email",
                "name",
                "role",
                "source",
                "pinned",
                "expiresAt",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["tenantId", "members"],
        "additionalProperties": false
      }
    },
    "partner.getUsage": {
      "kind": "query",
      "scope": "usage:read",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["tenantId"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "PARTNER_FREE",
              "STARTER",
              "PROFESSIONAL",
              "ENTERPRISE",
              "CUSTOM"
            ]
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quotas": {
            "type": "object",
            "properties": {
              "contacts": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "number"
                  },
                  "limit": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["used", "limit"],
                "additionalProperties": false
              },
              "seats": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "number"
                  },
                  "limit": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["used", "limit"],
                "additionalProperties": false
              },
              "emailsPerMonth": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "number"
                  },
                  "limit": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "measured": {
                    "type": "boolean"
                  }
                },
                "required": ["used", "limit", "measured"],
                "additionalProperties": false
              },
              "aiSpendCentsPerMonth": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "number"
                  },
                  "limit": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "measured": {
                    "type": "boolean"
                  }
                },
                "required": ["used", "limit", "measured"],
                "additionalProperties": false
              }
            },
            "required": [
              "contacts",
              "seats",
              "emailsPerMonth",
              "aiSpendCentsPerMonth"
            ],
            "additionalProperties": false
          },
          "asOf": {
            "type": "string"
          }
        },
        "required": ["tenantId", "plan", "modules", "quotas", "asOf"],
        "additionalProperties": false
      }
    },
    "inbound.createLead": {
