          },
          "tenantId": {
            "type": "string"
          },
          "submissionId": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        },
        "required": ["leadId", "tenantId", "submissionId", "created"],
        "additionalProperties": false
      }
