          }
        },
        "required": ["tenantId", "email"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "removed": {
            "type": "boolean"
          }
        },
        "required": ["removed"],
        "additionalProperties": false
      }
    },
    "partner.setMemberRole": {
      "kind": "mutation",
      "scope": "members:write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "enum": ["ADMIN", "MEMBER"]
          }
        },
        "required": ["tenantId", "email", "role"]
