{
  "contract": "intelliflow-partner-api",
  "version": "1.1.0",
  "transport": {
    "basePath": "/api/trpc",
    "auth": "Authorization: Bearer pk_<key>",
    "mutation": "POST <basePath>/<procedure> with the raw input as the JSON body",
    "query": "GET <basePath>/<procedure>?input=<url-encoded JSON of the raw input>",
    "transformer": "none"
  },
  "scopes": [
    "tenants:read",
    "tenants:write",
    "members:write",
    "auth:login-link",
    "usage:read"
  ],
  "procedures": {
    "partner.provisionTenant": {
      "kind": "mutation",
      "scope": "tenants:write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "externalRef": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "plan": {
            "type": "string",
            "enum": ["PARTNER_FREE", "STARTER", "PROFESSIONAL", "ENTERPRISE"]
          },
          "ownerEmail": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "ownerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": ["externalRef", "name", "plan", "ownerEmail"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "PARTNER_FREE",
              "STARTER",
              "PROFESSIONAL",
              "ENTERPRISE",
              "CUSTOM"
            ]
          },
          "created": {
            "type": "boolean"
          }
        },
        "required": ["tenantId", "slug", "plan", "created"],
        "additionalProperties": false
      }
    },
    "partner.getTenant": {
      "kind": "query",
      "scope": "tenants:read",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "externalRef": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["externalRef"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "tenantId": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "plan": {
                "type": "string",
                "enum": [
                  "PARTNER_FREE",
                  "STARTER",
                  "PROFESSIONAL",
                  "ENTERPRISE",
                  "CUSTOM"
                ]
              },
              "status": {
                "type": "string"
              }
            },
            "required": ["tenantId", "slug", "plan", "status"],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "partner.setPlan": {
      "kind": "mutation",
      "scope": "tenants:write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "type": "string",
            "enum": ["PARTNER_FREE", "STARTER", "PROFESSIONAL", "ENTERPRISE"]
          }
        },
        "required": ["tenantId", "plan"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "PARTNER_FREE",
              "STARTER",
              "PROFESSIONAL",
              "ENTERPRISE",
              "CUSTOM"
            ]
          }
        },
        "required": ["tenantId", "plan"],
        "additionalProperties": false
      }
    },
    "partner.inviteMember": {
      "kind": "mutation",
      "scope": "members:write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": ["ADMIN", "MEMBER"]
          }
        },
        "required": ["tenantId", "email", "role"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        },
        "required": ["userId", "created"],
        "additionalProperties": false
      }
    },
    "partner.issueLoginLink": {
      "kind": "mutation",
      "scope": "auth:login-link",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "redirectTo": {
            "type": "string",
            "format": "uri"
          },
          "assertion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": ["tenantId", "email"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": ["ADMIN", "MEMBER"]
          }
        },
        "required": ["url", "expiresAt"],
        "additionalProperties": false
      }
    },
    "partner.removeMember": {
      "kind": "mutation",
      "scope": "members:write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
