# Database connection for Prisma
# Development: Use local Docker Postgres
# Local database credentials, referenced below as ${DB_USER}/${DB_PASSWORD}
# (expanded by dotenv-cli, Prisma and Next.js). Not for shared or remote databases.
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/postgres?schema=public"
DIRECT_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/postgres?schema=public"

# Test: Use test database container
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5433/postgres?schema=public"
